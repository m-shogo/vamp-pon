{
  "name": "vamp-pon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "aseprite:check": "node scripts/aseprite/check-aseprite-cli.mjs",
    "aseprite:yui:hf-assist": "node scripts/aseprite/run-yui-52-v2a-handfinish-assistant.mjs",
    "aseprite:pixel-finisher:yui52": "node scripts/aseprite/run-pixel-finisher.mjs yui52",
    "aseprite:pixel-finisher:verify": "node scripts/aseprite/verify-pixel-finisher-output.mjs",
    "aseprite:pixel-refine:yui52hr": "node scripts/aseprite/run-yui-pf-human-refine.mjs",
    "aseprite:template:character": "node scripts/aseprite/create-character-template.mjs",
    "aseprite:preview:character": "node scripts/aseprite/export-character-previews.mjs",
    "aseprite:export": "node scripts/aseprite/export-player-assets.mjs",
    "aseprite:export:yui": "node scripts/aseprite/export-player-assets.mjs",
    "aseprite:export:player": "node scripts/aseprite/export-player-assets.mjs",
    "aseprite:export:proto": "node scripts/aseprite/export-prototype-assets.mjs",
    "generate:pixel-assets": "node --experimental-strip-types scripts/generate-pixel-assets.ts",
    "assets:verify": "node --experimental-strip-types scripts/generate-pixel-assets.ts --verify",
    "design:review:verify": "node --experimental-strip-types scripts/quality/check-design-review-docs.ts",
    "prototype:verify": "node --experimental-strip-types scripts/quality/check-prototype-artifacts.ts",
    "pixel-art:pipeline:verify": "node --experimental-strip-types scripts/quality/check-pixel-art-pipeline.ts",
    "player:protected:verify": "node --experimental-strip-types scripts/quality/check-protected-player-assets-unchanged.ts",
    "assets:check-player-promotion": "node --experimental-strip-types scripts/quality/check-player-asset-promotion.ts",
    "character-assets:verify": "node --experimental-strip-types scripts/quality/check-character-assets.ts",
    "core5:sprites:slice-original": "node --experimental-strip-types scripts/prototypes/slice-core5-original-sheets.ts",
    "core5:sprites:generate-exact": "node --experimental-strip-types scripts/prototypes/generate-core5-exact-sheets.ts",
    "core5:sprites:normalize": "node --experimental-strip-types scripts/prototypes/normalize-core5-sprite-sheets.ts",
    "enemy48:manifest:check": "node --experimental-strip-types scripts/quality/check-enemy-48-sprite-sheet.ts --manifest-only",
    "enemy48:sprites:verify": "node --experimental-strip-types scripts/quality/check-enemy-48-sprite-sheet.ts",
    "story-map:check": "node --experimental-strip-types scripts/quality/check-story-map-data.ts",
    "story-map:serve": "cd docs/story-map && python3 -m http.server 4173",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "phaser": "4.1.0",
    "vite": "8.0.16"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
