{
  "name": "vamp-pon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "aseprite:check": "node scripts/aseprite/check-aseprite-cli.mjs",
    "aseprite:template:character": "node scripts/aseprite/create-character-template.mjs",
    "assets:verify": "pnpm runtime-assets:verify && pnpm character-assets:verify && pnpm yui96:sprites:verify",
    "design:review:verify": "node --experimental-strip-types scripts/quality/check-design-review-docs.ts",
    "character-assets:verify": "node --experimental-strip-types scripts/quality/check-character-assets.ts",
    "core5:sprites:slice-original": "node --experimental-strip-types scripts/prototypes/slice-core5-original-sheets.ts",
    "enemy48:design:check": "node --experimental-strip-types scripts/quality/check-enemy-48-design.ts",
    "enemy48:manifest:check": "node --experimental-strip-types scripts/quality/check-enemy-48-sprite-sheet.ts --manifest-only",
    "enemy48:sprites:verify": "node --experimental-strip-types scripts/quality/check-enemy-48-sprite-sheet.ts",
    "inventory-icons:check": "node --experimental-strip-types scripts/quality/check-inventory-icon-stock.ts",
    "inventory-original-icons:check": "node --experimental-strip-types scripts/quality/check-inventory-original-icons.ts",
    "backgrounds:verify": "node --experimental-strip-types scripts/quality/check-backgrounds.ts",
    "runtime-assets:verify": "node --experimental-strip-types scripts/quality/check-runtime-asset-sources.ts",
    "yui96:sprites:verify": "node --experimental-strip-types scripts/quality/check-yui-96-sprites.ts",
    "stage1:fun-pass:verify": "pnpm assets:verify && pnpm test && pnpm build",
    "story-map:check": "node --experimental-strip-types scripts/quality/check-story-map-data.ts",
    "story-map:serve": "cd docs/story-map && python3 -m http.server 4173",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "phaser": "4.1.0",
    "vite": "8.0.16"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
