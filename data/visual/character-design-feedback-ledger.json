{
  "id": "yoru-no-shirube-character-design-feedback-ledger-v1",
  "date": "2026-08-13",
  "status": "DESIGNER_LEARNING_NON_CANON",
  "purpose": "Preserve candidate-by-candidate human feedback without mixing it with assistant interpretation, and carry only explicitly promoted recurrence directives into later candidate generation.",
  "rules": {
    "userFeedbackIsHighestPriorityWithinCandidateReview": true,
    "assistantDiagnosisMustBeSeparate": true,
    "singleReactionDoesNotCreateGlobalHardRule": true,
    "repeatedPatternMayBecomeCandidateLearning": true,
    "humanApprovalRequiredForPromotionToApprovedDesignRule": true,
    "namedArtistOrIpStyleTargetAllowed": false,
    "candidateReviewDoesNotAutomaticallyModifyGeneration": true,
    "onlyActiveRecurrenceDirectivesMayModifyLaterGeneration": true,
    "generatedImageNeverCreatesRecurrenceDirective": true
  },
  "candidateReviewSchema": {
    "candidateId": "string",
    "characterId": "string",
    "brainVersion": "string",
    "generationBriefVersion": "string|null",
    "referencesUsed": [
      {
        "path": "string",
        "role": "identity-evidence|rendering-evidence|composition-evidence",
        "authority": "string"
      }
    ],
    "userVerdict": "KEEP|OPEN|REWORK|REJECT|null",
    "userFeedback": ["faithful user statement or paraphrase"],
    "likedParts": ["string"],
    "dislikedParts": ["string"],
    "assistantDiagnosis": [
      {
        "class": "DESIGN_HYPOTHESIS",
        "dimension": "identity|rendering|costume|composition|world-fit|acting|derivation|association",
        "note": "string"
      }
    ],
    "keepElements": ["string"],
    "changeElements": ["string"],
    "associationNotes": ["string"],
    "nextDelta": ["string"],
    "promotionState": "prototype-only|candidate-learning|human-approved-design-rule|reference-candidate|commercial-candidate|rejected"
  },
  "recurrenceDirectiveSchema": {
    "id": "string",
    "scope": "CHARACTER|GLOBAL",
    "characterId": "string|null",
    "action": "KEEP|BAN|REPLACE|WARN",
    "dimension": "identity|rendering|costume|composition|world-fit|acting|derivation|association",
    "statement": "short executable design instruction",
    "replacement": "string|null",
    "authority": "USER_DECIDED|HUMAN_APPROVED_DESIGN_RULE|CANDIDATE_LEARNING",
    "state": "ACTIVE|PROPOSED|RETIRED",
    "sourceCandidateIds": ["string"],
    "evidence": ["faithful user feedback or approved review reference"],
    "createdByGeneratedImageAlone": false
  },
  "recurrenceRules": {
    "activeCharacterDirectiveAppliesOnlyToMatchingCharacter": true,
    "activeGlobalDirectiveRequiresHumanApprovedOrUserDecidedAuthority": true,
    "candidateLearningMayNotCreateGlobalBan": true,
    "proposedDirectiveDoesNotModifyGeneration": true,
    "retiredDirectiveDoesNotModifyGeneration": true,
    "banWithoutPositiveReplacementDoesNotAuthorizeRandomAlternative": true,
    "replaceMustNamePositiveTarget": true,
    "keepProtectsExistingAcceptedElementButDoesNotExpandIt": true,
    "warnAddsReviewAttentionButDoesNotOverrideHigherAuthority": true
  },
  "candidateReviews": [],
  "recurrenceDirectives": []
}
