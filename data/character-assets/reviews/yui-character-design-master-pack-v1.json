      "rounded cheeks",
      "non-pointed chin",
      "smaller almost-level almond-round brown eyes",
      "tapered double eyelids",
      "soft straight brows",
      "warm-dark asymmetric bob with one ear tuck",
      "bilateral smile dimples mandatory whenever smiling"
    ],
    "equipmentContinuity": [
      "Dominant hand is OPEN_NO_SOURCE; never infer it from held objects.",
      "Lantern is in Yui's anatomical RIGHT hand.",
      "In front view, anatomical right appears on viewer/screen left.",
      "Strap runs from anatomical RIGHT shoulder to anatomical LEFT waist.",
      "Bag rests at anatomical LEFT waist.",
      "Paper is in anatomical LEFT hand.",
      "In back view, anatomical right appears on viewer/screen right.",
      "Never substitute screen left/right for body left/right and never mirror asymmetric art."
    ],
    "construction": [
      "neutral orthographic-like standing views",
      "front, anatomical left, anatomical right, back",
      "identical scale and shared ground/proportion lines",
      "no perspective pose, action pose, layout crop, overlapping figures, readable labels or UI"
    ],
    "avoid": [
      "child, baby, loli or doll proportions",
      "generic V jaw or pointed chin",
      "giant eyes",
      "missing bilateral dimples in any smiling inset",
      "duplicated or mirrored side view",
      "wrong anatomical-side lantern, strap, bag or paper",
      "cross-view identity, costume or proportion drift",
      "Story, relationship, group, Reality Root, Star Beast, final or runtime inference",
      "readable text, logo, watermark, UI, poster composition"
