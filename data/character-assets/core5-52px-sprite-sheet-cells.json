{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "core5-52px-sprite-sheet-cells-v1",
  "status": "prototype-reference",
  "purpose": "Core 5 character sprite sheets use the same 8x6 logical layout so generated sheets can be reviewed, sliced, and later rebuilt into production sprites.",
  "cellSizePx": 52,
  "columns": 8,
  "rows": 6,
  "totalCells": 48,
  "productionRule": "These cells describe generated prototype sheets only. Do not treat a sheet as production until it is sliced, reviewed, Aseprite-normalized, and promoted by the player asset pipeline.",
  "cells": [
    { "index": 0, "row": 1, "column": 1, "key": "idle_front", "description": "Front idle pose. Main neutral gameplay standing frame." },
    { "index": 1, "row": 1, "column": 2, "key": "idle_front_blink", "description": "Front idle alternate blink or soft expression frame." },
    { "index": 2, "row": 1, "column": 3, "key": "idle_left", "description": "Left-facing or left three-quarter idle pose." },
    { "index": 3, "row": 1, "column": 4, "key": "idle_right", "description": "Right-facing or right three-quarter idle pose." },
    { "index": 4, "row": 1, "column": 5, "key": "idle_back", "description": "Back-facing idle pose. Shows cloak/hair/back silhouette." },
    { "index": 5, "row": 1, "column": 6, "key": "ready_front", "description": "Front ready pose with character vessel or weapon visible." },
    { "index": 6, "row": 1, "column": 7, "key": "ready_left", "description": "Left-facing ready pose with vessel/weapon held." },
    { "index": 7, "row": 1, "column": 8, "key": "ready_right", "description": "Right-facing ready pose with vessel/weapon held." },

    { "index": 8, "row": 2, "column": 1, "key": "walk_front_a", "description": "Front walk cycle frame A." },
    { "index": 9, "row": 2, "column": 2, "key": "walk_front_b", "description": "Front walk cycle frame B." },
    { "index": 10, "row": 2, "column": 3, "key": "walk_left_a", "description": "Left walk cycle frame A." },
    { "index": 11, "row": 2, "column": 4, "key": "walk_left_b", "description": "Left walk cycle frame B." },
    { "index": 12, "row": 2, "column": 5, "key": "walk_right_a", "description": "Right walk cycle frame A." },
    { "index": 13, "row": 2, "column": 6, "key": "walk_right_b", "description": "Right walk cycle frame B." },
    { "index": 14, "row": 2, "column": 7, "key": "walk_back_a", "description": "Back walk cycle frame A." },
    { "index": 15, "row": 2, "column": 8, "key": "walk_back_b", "description": "Back walk cycle frame B." },

    { "index": 16, "row": 3, "column": 1, "key": "cast_front", "description": "Front cast frame using the character vessel and signature light." },
    { "index": 17, "row": 3, "column": 2, "key": "cast_left", "description": "Left-facing cast frame." },
    { "index": 18, "row": 3, "column": 3, "key": "cast_right", "description": "Right-facing cast frame." },
    { "index": 19, "row": 3, "column": 4, "key": "cast_back", "description": "Back-facing cast frame or rear vessel activation." },
    { "index": 20, "row": 3, "column": 5, "key": "attack_front", "description": "Front attack or thrust frame." },
    { "index": 21, "row": 3, "column": 6, "key": "attack_left", "description": "Left attack frame with short effect trail." },
    { "index": 22, "row": 3, "column": 7, "key": "attack_right", "description": "Right attack frame with short effect trail." },
    { "index": 23, "row": 3, "column": 8, "key": "attack_back", "description": "Back attack or rear effect frame." },

    { "index": 24, "row": 4, "column": 1, "key": "hurt_front", "description": "Front hurt or damage reaction." },
    { "index": 25, "row": 4, "column": 2, "key": "hurt_left", "description": "Left hurt or knockback reaction." },
    { "index": 26, "row": 4, "column": 3, "key": "hurt_right", "description": "Right hurt or knockback reaction." },
    { "index": 27, "row": 4, "column": 4, "key": "hurt_back", "description": "Back hurt or recoil reaction." },
    { "index": 28, "row": 4, "column": 5, "key": "recoil_front", "description": "Front recoil, weak stagger, or bracing frame." },
    { "index": 29, "row": 4, "column": 6, "key": "recoil_left", "description": "Left recoil or crouch frame." },
    { "index": 30, "row": 4, "column": 7, "key": "recoil_right", "description": "Right recoil or crouch frame." },
    { "index": 31, "row": 4, "column": 8, "key": "recoil_back", "description": "Back recoil or turned-away weak frame." },

    { "index": 32, "row": 5, "column": 1, "key": "special_normal", "description": "Normal special/ultimate ready frame. Correct shirushi release." },
    { "index": 33, "row": 5, "column": 2, "key": "special_black", "description": "Black-evolution or corrupted special frame. Wrong-reading release." },
    { "index": 34, "row": 5, "column": 3, "key": "pickup", "description": "Pickup or crouch interaction frame." },
    { "index": 35, "row": 5, "column": 4, "key": "interact", "description": "Set vessel down, inspect object, or use memory item." },
    { "index": 36, "row": 5, "column": 5, "key": "downed", "description": "Downed, fallen, or defeated frame." },
    { "index": 37, "row": 5, "column": 6, "key": "rest", "description": "Sit/rest frame. Useful for camp, result, or story scenes." },
    { "index": 38, "row": 5, "column": 7, "key": "emote_happy", "description": "Happy or positive emote frame." },
    { "index": 39, "row": 5, "column": 8, "key": "emote_surprised", "description": "Surprised, warning, or emergency emote frame." },

    { "index": 40, "row": 6, "column": 1, "key": "portrait_neutral", "description": "Square portrait icon, neutral expression." },
    { "index": 41, "row": 6, "column": 2, "key": "portrait_alt", "description": "Square portrait icon, alternate expression." },
    { "index": 42, "row": 6, "column": 3, "key": "vessel_icon", "description": "Main vessel/weapon icon." },
    { "index": 43, "row": 6, "column": 4, "key": "secondary_item_icon", "description": "Secondary personal item icon such as bag, key, map, repair kit, or paper tag." },
    { "index": 44, "row": 6, "column": 5, "key": "crest_normal", "description": "Normal shirushi crest icon." },
    { "index": 45, "row": 6, "column": 6, "key": "crest_black", "description": "Corrupted or black-evolution crest icon." },
    { "index": 46, "row": 6, "column": 7, "key": "memory_item_icon", "description": "Small memory item or pickup candidate icon." },
    { "index": 47, "row": 6, "column": 8, "key": "effect_icon", "description": "Small glow/effect icon for the character's signature light." }
  ]
}
