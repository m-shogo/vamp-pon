{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/m-shogo/vamp-pon/data/pixel-art/character-recipes.schema.json",
  "title": "Vamp Pon Character Recipe",
  "description": "見た目・役割・色・持ち物・シルエット・禁止事項をrecipe化し、キャラ量産とprocedural finishの単一の出所にする。docs/pixel-art/vamp-pon-pixel-art-pipeline-v1.md を参照。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "role",
    "importance",
    "canvasSize",
    "basePose",
    "silhouetteKeywords",
    "palette",
    "faceRules",
    "hairRules",
    "outfitRules",
    "glowRules",
    "hitCoreSeparationRules",
    "backgroundSeparationRules",
    "mustKeep",
    "mustAvoid",
    "reviewPriority",
    "humanReviewRequired"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "ファイル名にも使う安定ID（例: yui）"
    },
    "name": { "type": "string", "description": "表示名（例: ユイ）" },
    "role": { "type": "string", "description": "ゲーム内の役割（例: player / mascot, light bearer）" },
    "importance": {
      "type": "string",
      "enum": ["player", "main", "side", "enemy", "item"],
      "description": "制作ルートと humanReviewRequired を決める重要度"
    },
    "canvasSize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 8, "maximum": 256 },
        "height": { "type": "integer", "minimum": 8, "maximum": 256 }
      }
    },
    "basePose": {
      "type": "string",
      "description": "最初に作る基準ポーズ（例: idle）"
    },
    "silhouetteKeywords": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "1xでシルエットだけで伝えたい特徴語"
    },
    "palette": {
      "type": "array",
      "minItems": 1,
      "description": "使用色。同一ファミリーは色を共有する。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "hex", "use"],
        "properties": {
          "name": { "type": "string" },
          "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "use": { "type": "string", "description": "用途（hood base / hair shadow など）" }
        }
      }
    },
    "faceRules": { "type": "array", "items": { "type": "string" } },
    "hairRules": { "type": "array", "items": { "type": "string" } },
    "outfitRules": { "type": "array", "items": { "type": "string" } },
    "vessel": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "description": "持ち物 / アイテム（ランタン等）。無ければ null。",
      "properties": {
        "name": { "type": "string" },
        "side": { "type": "string", "enum": ["left", "right", "center", "none"] },
        "rules": { "type": "array", "items": { "type": "string" } }
      }
    },
    "glowRules": { "type": "array", "items": { "type": "string" } },
    "hitCoreSeparationRules": { "type": "array", "items": { "type": "string" } },
    "backgroundSeparationRules": { "type": "array", "items": { "type": "string" } },
    "mustKeep": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "固定アイデンティティ（必ず維持）"
    },
    "mustAvoid": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "禁止事項（NG）"
    },
    "reviewPriority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "1=最優先。player=1。"
    },
    "humanReviewRequired": {
      "type": "boolean",
      "description": "production昇格に人間レビューが必須か"
    },
    "humanReviewReason": {
      "type": "string",
      "description": "humanReviewRequired をその値にした理由"
    },
    "finisherMode": {
      "type": "string",
      "description": "対応する vamp-pon-pixel-finisher.lua の mode（例: yui52-v2a / generic-character-52）。未対応なら stub 名でよい。"
    },
    "status": {
      "type": "string",
      "enum": [
        "generated-draft",
        "procedural-prototype",
        "script-assisted-candidate",
        "human-reviewed-candidate",
        "production-candidate",
        "hand-final",
        "rejected"
      ],
      "description": "現在のasset status（pipeline doc §4）"
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
